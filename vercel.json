{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "env": {
    "MEDIVAULT_DB_PATH": "/tmp/medivault.db",
    "MEDIVAULT_LOG_FILE": "/tmp/medivault.log",
    "MEDIVAULT_SEED_DEMO": "true"
  }
}
